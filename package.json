{
  "name": "passaic-transport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev": "next dev --turbopack",
    "postinstall": "node scripts/prisma-postinstall.cjs",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-db-setup.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "SEED_DEMO=1 tsx prisma/seed.ts",
    "db:seed:empty": "SEED_DEMO=0 tsx prisma/seed.ts",
    "db:deploy": "prisma db push --schema prisma/schema.postgres.prisma && SEED_DEMO=0 tsx prisma/seed.ts",
    "db:reset": "prisma db push && SEED_DEMO=1 tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "docxtemplater": "^3.69.3",
    "jose": "^6.2.10",
    "next": "15.5.23",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.2.0",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
